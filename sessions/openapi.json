          }
        }
      ]
    },
    "/api/v1/invitations/{iid}": {
      "delete": {
        "summary": "Revoke owned invitation and remove its participants",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Credential missing, invalid, expired or revoked"
          },
          "403": {
