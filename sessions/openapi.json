{
  "openapi": "3.1.0",
  "info": {
    "title": "StreamHive Sessions control API",
    "version": "0.1.0",
    "description": "Control only. No media tokens, tracks, recordings or administrative global credentials. All epoch times are seconds. Session/invitation TTL: 24 hours. Browser writes and guest sockets must use the configured public origin. Reconnect by fetching a fresh snapshot; revisions are monotonic for persisted mutations."
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "summary": "Service identity, protocol=1 and media=false",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Credential missing, invalid, expired or revoked"
          },
          "403": {
            "description": "Browser origin mismatch"
          },
          "404": {
            "description": "Resource absent or owned by another installation"
          },
          "409": {
            "description": "Protocol conflict"
          },
          "410": {
            "description": "Invitation expired or revoked"
          },
          "429": {
            "description": "Configured rate or capacity limit"
          }
        },
        "security": []
      }
    },
    "/api/v1/installations": {
      "post": {
        "summary": "Register automatically; returns installation_id and a one-time 256-bit credential",
