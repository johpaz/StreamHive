          },
          "429": {
            "description": "Configured rate or capacity limit"
          }
        },
        "security": [
          {
            "installation": []
          }
        ]
      },
      "parameters": [
        {
          "name": "sid",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/sessions/{sid}/close": {
      "post": {
        "summary": "Idempotently close an owned session",
        "responses": {
          "200": {
            "description": "Success"
