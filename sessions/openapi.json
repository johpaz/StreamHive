            "installation": []
          }
        ]
      },
      "parameters": [
        {
          "name": "iid",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/sessions/{sid}/participants/{pid}": {
      "post": {
        "summary": "Admit, reject or remove an owned participant",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Credential missing, invalid, expired or revoked"
          },
          "403": {
            "description": "Browser origin mismatch"
          },
          "404": {
            "description": "Resource absent or owned by another installation"
          },
          "409": {
            "description": "Protocol conflict"
          },
          "410": {
            "description": "Invitation expired or revoked"
          },
          "429": {
            "description": "Configured rate or capacity limit"
          }
        },
        "security": [
          {
            "installation": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "admit",
                      "reject",
                      "remove"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "sid",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "pid",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/join/{token}": {
      "post": {
        "summary": "Join waiting room; sets HttpOnly/SameSite=Strict guest cookie",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Credential missing, invalid, expired or revoked"
          },
          "403": {
            "description": "Browser origin mismatch"
          },
          "404": {
            "description": "Resource absent or owned by another installation"
          },
          "409": {
            "description": "Protocol conflict"
          },
          "410": {
            "description": "Invitation expired or revoked"
          },
          "429": {
            "description": "Configured rate or capacity limit"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Resume cookie session only if it belongs to this invitation",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Credential missing, invalid, expired or revoked"
          },
          "403": {
            "description": "Browser origin mismatch"
          },
          "404": {
            "description": "Resource absent or owned by another installation"
          },
          "409": {
            "description": "Protocol conflict"
          },
          "410": {
            "description": "Invitation expired or revoked"
          },
          "429": {
            "description": "Configured rate or capacity limit"
          }
        },
        "security": [
          {
            "guest": []
          }
        ]
      },
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/guest": {
      "get": {
        "summary": "Own guest state only; guest cookie required",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Credential missing, invalid, expired or revoked"
          },
          "403": {
            "description": "Browser origin mismatch"
          },
          "404": {
            "description": "Resource absent or owned by another installation"
          },
          "409": {
            "description": "Protocol conflict"
          },
          "410": {
            "description": "Invitation expired or revoked"
          },
          "429": {
            "description": "Configured rate or capacity limit"
          }
        },
        "security": [
          {
            "guest": []
          }
        ]
      }
    },
    "/api/v1/events": {
      "get": {
        "summary": "WebSocket: initial and updated {type:snapshot,data:...}; installation bearer header or guest cookie required",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Credential missing, invalid, expired or revoked"
          },
          "403": {
            "description": "Browser origin mismatch"
          },
          "404": {
            "description": "Resource absent or owned by another installation"
          },
          "409": {
            "description": "Protocol conflict"
          },
          "410": {
            "description": "Invitation expired or revoked"
          },
          "429": {
            "description": "Configured rate or capacity limit"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Existing refresh/snapshot protocol plus chat.message, chat.deleted and chat.closed notifications with conversation_id; chat.sync requests resynchronization after lag. Notifications contain no message text. Fetch /api/v1/chat/messages using the last confirmed event cursor. Check admission for every delivery; reconnect and poll as a fallback."
      }
    },
    "/api/v1/chat/messages": {
      "get": {
        "summary": "Host, admitted and waiting participants: paginated chat history or incremental changes",
        "security": [
          {
            "installation": []
          },
          {
            "guest": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Active conversation; local GET may omit to discover the current conversation"
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Event cursor; up to 100 changes per page, including deletions"
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Older message cursor; up to 50 messages. Cannot combine with after."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid text, identifier or cursor"
          },
          "401": {
            "description": "Authentication or current admission required"
          },
          "404": {
            "description": "Session absent or belongs to another owner"
          },
          "410": {
            "description": "Conversation closed or changed"
          },
          "429": {
            "description": "30 messages/minute, at most 5 in any 10 seconds per participant"
          }
        }
      },
      "post": {
        "summary": "Host, admitted and waiting participants: send an idempotent plain-text message",
        "security": [
          {
            "installation": []
          },
          {
            "guest": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatSend"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid text, identifier or cursor"
          },
          "401": {
            "description": "Authentication or current admission required"
          },
          "404": {
            "description": "Session absent or belongs to another owner"
          },
          "410": {
            "description": "Conversation closed or changed"
          },
          "429": {
            "description": "30 messages/minute, at most 5 in any 10 seconds per participant"
          }
        }
      }
    },
    "/api/v1/chat/messages/{id}": {
      "delete": {
        "summary": "Host: delete a message and synchronize a tombstone",
        "security": [
          {
            "installation": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Active conversation; local GET may omit to discover the current conversation"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid text, identifier or cursor"
          },
          "401": {
            "description": "Authentication or current admission required"
          },
          "404": {
            "description": "Session absent or belongs to another owner"
          },
          "410": {
            "description": "Conversation closed or changed"
          },
          "429": {
            "description": "30 messages/minute, at most 5 in any 10 seconds per participant"
          }
        }
      }
    },
    "/api/v1/chat/files": {
      "post": {
        "summary": "Host, admitted and waiting participants: upload a file to share in the chat (PDF, PNG/JPG/WebP, TXT/CSV/MD, DOCX/XLSX/PPTX, ODT/ODS/ODP, ZIP). Send it afterwards with attachment_id.",
        "security": [
          {
            "installation": []
          },
          {
            "guest": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-file-name",
            "in": "header",
            "required": true,
            "description": "Original name, UTF-8 encoded in base64",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored, waiting to be sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatAttachment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name, empty file, or the content does not match an allowed format"
          },
          "401": {
            "description": "Authentication or current admission (or waiting room) required"
          },
          "410": {
            "description": "Conversation closed or changed"
          },
          "413": {
            "description": "More than 25 MB"
          },
          "429": {
            "description": "More than 10 files per minute per participant"
          }
        }
      }
    },
    "/api/v1/chat/files/{id}": {
      "get": {
        "summary": "Download a file sent in a message that has not been deleted. Always served as an attachment with nosniff.",
        "security": [
          {
            "installation": []
          },
          {
            "guest": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename*=UTF-8''…"
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Authentication or current admission (or waiting room) required"
          },
          "404": {
            "description": "Unknown, unsent or deleted file"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "installation": {
        "type": "http",
        "scheme": "bearer"
      },
      "guest": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sh_guest"
      }
    },
    "schemas": {
      "ChatMessage": {
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "sender_id",
          "sender_name",
          "sender_role",
          "text",
          "created_at",
          "deleted",
          "client_message_id",
          "sequence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string"
          },
          "sender_id": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "sender_role": {
            "type": "string",
            "description": "waiting: escrito desde la sala de espera",
            "enum": [
              "admin",
              "guest",
              "waiting"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "created_at": {
            "type": "integer",
            "description": "Server Unix seconds"
          },
          "deleted": {
            "type": "boolean"
          },
          "client_message_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer"
          },
          "attachment": {
            "description": "Shared file; null when none or after deletion",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatAttachment"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ChatSend": {
        "type": "object",
        "required": [
          "session_id",
          "client_message_id"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "client_message_id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Up to 2000 characters; may be empty when attachment_id is present"
          },
          "attachment_id": {
            "type": "string",
            "format": "uuid",
            "description": "File uploaded by the same sender with POST /api/v1/chat/files and not yet sent; text may then be empty"
          }
        }
      },
      "ChatPage": {
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": "string"
          },
          "viewer_id": {
            "type": "string"
          },
          "can_reset": {
            "type": "boolean",
            "default": false
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "chat.message",
                    "chat.deleted"
                  ]
                },
                "sequence": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              }
            }
          },
          "cursor": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_before": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "ChatAttachment": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mime",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 180
          },
