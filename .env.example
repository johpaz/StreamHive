# Generate .env and matching service configuration with scripts/configure.py.
APP_DOMAIN=studio.example.com
LIVEKIT_DOMAIN=rtc.example.com
TURN_DOMAIN=turn.example.com
ACME_EMAIL=you@example.com
PUBLIC_ORIGIN=https://studio.example.com
LIVEKIT_PUBLIC_URL=wss://rtc.example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
SESSION_SECRET=replace-with-32-or-more-random-characters
MASTER_KEY=replace-with-base64-of-32-random-bytes
LIVEKIT_API_KEY=replace-with-random-key
LIVEKIT_API_SECRET=replace-with-32-or-more-random-characters
REDIS_PASSWORD=replace-with-random-password
RUST_LOG=streamhive=info
VIDEO_BITRATE_KBPS=6000
AUDIO_BITRATE_KBPS=160
