SESSIONS_DOMAIN=sesiones.example.com
SESSIONS_IMAGE=johpaz/streamhive-sessions
SESSIONS_TAG=0.1.0
COMPOSE_PROJECT_NAME=streamhive-sessions
SESSIONS_MEMORY_LIMIT=384m
SESSIONS_CPU_LIMIT=0.5
REGISTRATIONS_PER_HOUR=120
REQUESTS_PER_MINUTE=600
MAX_CONNECTIONS=1000
# Cámara y audio (LiveKit). Abre estos puertos en el firewall del VPS.
MEDIA_UDP_PORT=7882
MEDIA_TCP_PORT=7881
# Vacío: se descubre la IP pública del VPS. Ponla si tiene varias.
MEDIA_PUBLIC_IP=
MEDIA_MEMORY_LIMIT=1g
MEDIA_CPU_LIMIT=1.5
# Only required with compose.caddy.yaml:
ACME_EMAIL=admin@example.com
