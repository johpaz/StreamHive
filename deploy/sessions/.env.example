SESSIONS_DOMAIN=sesiones.example.com
SESSIONS_IMAGE=johpaz/streamhive-sessions
SESSIONS_TAG=0.1.0
COMPOSE_PROJECT_NAME=streamhive-sessions
SESSIONS_MEMORY_LIMIT=384m
SESSIONS_CPU_LIMIT=0.5
REGISTRATIONS_PER_HOUR=120
REQUESTS_PER_MINUTE=600
MAX_CONNECTIONS=1000
